# Template only. Copy to ".env" for local use. NEVER put a real password or database address in this file, and never commit ".env".
# Real values for the hosted server are set in the host's dashboard (Render > the service > Environment), not in files.
# The game server itself does not use the database yet; these settings are for the database tools in db/ and for verify.js.

# --- required for every database command (there is no default) ---
APP_ENV=development                      # development | staging | production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME

# --- game server ---
PORT=3000
ALLOWED_ORIGINS=                         # comma-separated web origins allowed to connect, e.g. https://yourname.github.io (empty = any)

# --- database safety ---
# development/staging may use only LOCAL databases, plus remote hosts listed here (an allow-list):
BB_ALLOWED_DB_HOSTS=
# optional extra block-list of hosts that must never be used by development/staging:
BB_PROTECTED_DB_HOSTS=
# production only, per operation: must equal the exact production DATABASE NAME (not "yes"):
# BB_CONFIRM_PRODUCTION=PRODUCTION_DATABASE_NAME
# copying production data into a non-production database needs this explicit flag:
# BB_ALLOW_PROD_DATA_COPY=yes
# number of backups to keep when rotating:
# BB_BACKUP_KEEP=14

# --- database connection ---
DB_DRIVER=pg                             # pg (real adapter, default for the tools) | psql (test helper only)
DB_SSL=auto                              # auto | disable | require | verify  (auto = off for local, encrypted for remote)
# DB_SSL_CA=/path/to/ca.pem              # only with DB_SSL=verify

# --- tests (only ever point these at a throw-away local database) ---
# BB_ADMIN_URL=postgresql://postgres:PASSWORD@localhost:5432/postgres
# BB_TEST_ALLOW_REMOTE=yes               # only for a throw-away remote test server
# RENDER_CHECK_URL=postgresql://USER:PASSWORD@HOST/STAGING_DATABASE_NAME    # STAGING database, read-only check; in GitHub it is a repository secret
# RENDER_CHECK_ENV=staging
